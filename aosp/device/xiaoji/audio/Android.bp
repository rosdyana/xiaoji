// XiaoJi audio HAL: a null sink (one speaker output, one built-in mic input). The sources are
// the goldfish ranchu HIDL 7.0 implementation (device/generic/goldfish/audio), with the PCM
// backend replaced by talsa.cpp (paced, silent, discarding). See docs/boot.md, B13.

package {
    default_applicable_licenses: ["device_xiaoji_audio_license"],
}

license {
    name: "device_xiaoji_audio_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_defaults {
    name: "android.hardware.audio@7.x-impl.xiaoji_default",
    vendor: true,
    relative_install_path: "hw",
    defaults: ["hidl_defaults"],
    srcs: [
        "entry.cpp",
        "device_factory.cpp",
        "primary_device.cpp",
        "stream_common.cpp",
        "stream_in.cpp",
        "stream_out.cpp",
        "io_thread.cpp",
        "device_port_source.cpp",
        "device_port_sink.cpp",
        "talsa.cpp",
        "ring_buffer.cpp",
        "audio_ops.cpp",
        "util.cpp",
    ],
    shared_libs: [
        "android.hardware.audio@7.0",
        "android.hardware.audio@7.0-util",
        "android.hardware.audio.common@7.0",
        "android.hardware.audio.common@7.0-util",
        "libaudioutils",
        "libbase",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "libfmq",
        "libprocessgroup",
    ],
    header_libs: [
        "android.hardware.audio.common.util@all-versions",
        "libaudio_system_headers",
    ],
    cflags: [
        "-include common/all-versions/VersionMacro.h",
    ],
}

cc_library_shared {
    name: "android.hardware.audio@7.0-impl.xiaoji",
    defaults: ["android.hardware.audio@7.x-impl.xiaoji_default"],
    vintf_fragments: ["android.hardware.audio@7.0-impl.xiaoji.xml"],
    shared_libs: [
        "android.hardware.audio.common@7.0-enums",
    ],
    cflags: [
        "-DLOG_TAG=\"android.hardware.audio@7.0-impl.xiaoji\"",
        "-DMAJOR_VERSION=7",
        "-DMINOR_VERSION=0",
        "-include common/all-versions/VersionMacro.h",
    ],
}

// The HIDL service that serves the implementation above (passthrough). Started by image/xiaoji.rc.
cc_binary {
    name: "xiaoji_audio_hal",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["service/xiaoji_audio_hal.cpp"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-DLOG_TAG=\"xiaoji_audio_hal\"",
    ],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    required: [
        "android.hardware.audio@7.0-impl.xiaoji",
    ],
}
