# The boot config of the engine's init (B4a): run with
#   xiaoji --init image/xiaoji.rc --root build/rootfs
# The global environment is init.environ.rc's early-init block (its imports are not followed).
# The servicemanager and zygote blocks are the Android 13 rc files, copied verbatim: options the
# engine does not model (class, onrestart, critical, task_profiles, ...) are ignored. user, group and
# capabilities are applied (engine/init.c, cred_apply_service).
# BOOTCLASSPATH and the other classpath variables are derived by the engine (engine/init.c).
on early-init
    export ANDROID_BOOTLOGO 1
    export ANDROID_ROOT /system
    export ANDROID_ASSETS /system/app
    export ANDROID_DATA /data
    export ANDROID_STORAGE /storage
    export ANDROID_ART_ROOT /apex/com.android.art
    export ANDROID_I18N_ROOT /apex/com.android.i18n
    export ANDROID_TZDATA_ROOT /apex/com.android.tzdata
    export EXTERNAL_STORAGE /sdcard
    export ASEC_MOUNTPOINT /mnt/asec
    # lmkd (B9): vendor/build.prop sets ro.config.low_ram, which makes lmkd use per-app memcg (cgroup v1 soft
    # limits). The engine has no memcg, so lmkd records the processes without it (system/memory/lmkd/lmkd.cpp,
    # cmd_procprio: the per-app branch returns before the record is kept). This is the stock property, not a change of low_ram.
    setprop ro.config.per_app_memcg false
    mkdir /data/dalvik-cache 0771
    mkdir /data/dalvik-cache/arm64 0771
    # The user storage tree that zygote prepares for system_server (init.rc's on-init block makes
    # these). zygote's bind mounts (/storage) are made in its own mount namespace (engine/mntns.c, B4c).
    mkdir /mnt/user 0755
    mkdir /mnt/user/0 0755
    # The rest of the stock init.rc /mnt tree (B13), which zygote's specialization and the storage views open:
    mkdir /mnt/secure
    mkdir /mnt/secure/asec
    mkdir /mnt/asec
    mkdir /mnt/obb
    mkdir /mnt/media_rw
    mkdir /mnt/user/0/self
    mkdir /mnt/user/0/emulated
    mkdir /mnt/user/0/emulated/0
    mkdir /mnt/pass_through
    mkdir /mnt/pass_through/0
    mkdir /mnt/pass_through/0/self
    mkdir /mnt/pass_through/0/emulated
    mkdir /mnt/pass_through/0/emulated/0
    mkdir /mnt/expand
    mkdir /mnt/appfuse
    mkdir /mnt/runtime
    mkdir /mnt/runtime/default
    mkdir /mnt/runtime/default/self
    mkdir /mnt/runtime/read
    mkdir /mnt/runtime/read/self
    mkdir /mnt/runtime/write
    mkdir /mnt/runtime/write/self
    # installd's directories (init.rc's on-init block makes these). The engine's mkdir takes the path only:
    # the mode is 0771 and the owner is the engine's, whatever the rc says.
    mkdir /data/misc
    mkdir /data/misc/user
    mkdir /data/misc/installd
    # keystore's directory (stock init.rc: mkdir /data/misc/keystore 0700 keystore keystore), for keystore2 below.
    mkdir /data/misc/keystore
    # gatekeeperd's directory (stock: mkdir /data/misc/gatekeeper 0700 system system). The engine's mkdir takes the path
    # only, so the owner is the engine's default (B16).
    mkdir /data/misc/gatekeeper
    # /data/media (stock init.rc, post-fs-data: mkdir /data/media 0770 media_rw media_rw) and user 0's emulated
    # storage under it. The stock path makes /data/media/0 when vold mounts the emulated volume, which needs an
    # fstab this engine does not have; without it vold fails the unlock (chmod /data/media/0) and system_server
    # aborts on the failed user data (B16).
    mkdir /data/media
    mkdir /data/media/0
    # ART's profile directories (init.rc's block for profiles, and cur/0 from vold): installd fails to prepare a
    # package's profile without them (B7).
    mkdir /data/misc/profiles 0771
    mkdir /data/misc/profiles/cur 0771
    mkdir /data/misc/profiles/cur/0 0771
    mkdir /data/misc/profiles/ref 0771
    # idmap2d (B6): IdmapDaemon writes under /data/resource-cache; idmap2d refuses any caller when the directory
    # is missing (UidHasWriteAccessToPath fails on Realpath). init.rc creates it 0771 system system.
    mkdir /data/resource-cache 0771
    # WebView's relro file (B14): WebViewLibraryLoader writes libwebviewchromium64.relro under it (init.rc's post-fs-data
    # line is "mkdir /data/misc/shared_relro 0771 shared_relro shared_relro"; the engine's mkdir takes the path only).
    mkdir /data/misc/shared_relro
    # The user 0 tree that vold prepares (system/vold/vold_prepare_subdirs.cpp, prepare_subdirs, and init.rc's
    # /data/user block). The engine has no vold, so the directories are made here, by path. installd and
    # SettingsProvider need them: ContextImpl and installd fail to create databases and app data under a
    # missing parent (B7). The bind of /data/user/0 to /data/data is made below (B14), as the stock init.rc does.
    mkdir /data/user
    mkdir /data/user/0
    # /data/data (B13): the stock init.rc line. zygote's app specialization mounts a tmpfs on it (Zygote.cpp,
    # "MountAppDataTmpFs"), in its own mount namespace, so it must exist as a directory.
    mkdir /data/data 0771 system system encryption=None
    mkdir /data/user_de
    mkdir /data/user_de/0
    mkdir /data/system_ce
    mkdir /data/system_ce/0
    mkdir /data/system_de
    mkdir /data/system_de/0
    mkdir /data/misc_ce
    mkdir /data/misc_ce/0
    mkdir /data/misc_de
    mkdir /data/misc_de/0
    mkdir /data/vendor_ce
    mkdir /data/vendor_ce/0
    mkdir /data/vendor_de
    mkdir /data/vendor_de/0
    # The cgroup subgroups that the stock init.rc makes (B11): task_profiles.json joins them, and a join needs the
    # directory. The engine makes them in its cgroup namespace (engine/cgroupfs.c, cgroups.json's mounts); the
    # "copy" lines of the stock file and the schedtune mount (not in cgroups.json for API 33) are left out.
    mkdir /dev/cpuctl/foreground
    mkdir /dev/cpuctl/background
    mkdir /dev/cpuctl/top-app
    mkdir /dev/cpuctl/rt
    mkdir /dev/cpuctl/system
    mkdir /dev/cpuctl/system-background
    mkdir /dev/cpuctl/dex2oat
    mkdir /dev/cpuctl/nnapi-hal
    mkdir /dev/cpuctl/camera-daemon
    mkdir /dev/cpuset/foreground
    mkdir /dev/cpuset/background
    mkdir /dev/cpuset/system-background
    mkdir /dev/cpuset/restricted
    mkdir /dev/cpuset/top-app
    mkdir /dev/cpuset/camera-daemon
    mkdir /dev/blkio/background
    mkdir /dev/memcg/apps
    mkdir /dev/memcg/system
    # The storage views and the data mirror (B14): the stock init.rc lines, in its order (its "on post-fs" and
    # "on post-fs-data" blocks), made by the engine's init as mount(2) in its own namespace, which the services inherit.
    # The stock "mount rootfs rootfs / remount bind ro nodev" is not made (the engine's root has no flags to change), and
    # the restorecon lines are not made (the engine keeps no labels). The stock "rm /data/user/0" is left out: /data/user/0
    # is made as a directory above, never as the symlink that line removes.
    mount none /mnt/user/0 /storage bind rec
    mount none none /storage slave rec
    # The installer's view of the emulated storage (B16): zygote specializes an installer app by mounting /mnt/installer/0
    # on /storage (Zygote.cpp, "Failed to mount /mnt/installer/0 to /storage" aborted the PackageInstaller's process). vold
    # makes /mnt/installer/<user> on a device; here it is a bind of user 0's view, as the emulated volume's.
    mkdir /mnt/installer
    mkdir /mnt/installer/0
    mount none /mnt/user/0 /mnt/installer/0 bind rec
    symlink /storage/self/primary /mnt/sdcard
    symlink /mnt/user/0/primary /mnt/runtime/default/self/primary
    # The VNDK APEX under its versioned name (B14): nativeloader reads /apex/com.android.vndk.v<ro.vndk.version>/etc/
    # llndk.libraries.<version>.txt (vendor/build.prop: 33), and the image carries only com.android.vndk.current, which has
    # that file. Without the name, the WebView relro process aborts in ClassLoaderFactory.createClassloaderNamespace.
    symlink /apex/com.android.vndk.current /apex/com.android.vndk.v33
    mkdir /mnt/runtime/full 0755 root root
    mkdir /mnt/runtime/full/self 0755 root root
    mount none /data/data /data/user/0 bind rec
    mount tmpfs tmpfs /data_mirror nodev noexec nosuid mode=0700,uid=0,gid=1000
    mkdir /data_mirror/data_ce 0700 root root
    mkdir /data_mirror/data_de 0700 root root
    mkdir /data_mirror/data_ce/null 0700 root root
    mkdir /data_mirror/data_de/null 0700 root root
    mount none /data/user /data_mirror/data_ce/null bind rec
    mount none /data/user_de /data_mirror/data_de/null bind rec
    mkdir /data_mirror/cur_profiles 0700 root root
    mount none /data/misc/profiles/cur /data_mirror/cur_profiles bind rec
    mkdir /data_mirror/ref_profiles 0700 root root
    mount none /data/misc/profiles/ref /data_mirror/ref_profiles bind rec

service servicemanager /system/bin/servicemanager
    class core animation
    user system
    group system readproc
    critical
    onrestart restart apexd
    onrestart restart audioserver
    onrestart restart gatekeeperd
    onrestart class_restart --only-enabled main
    onrestart class_restart --only-enabled hal
    onrestart class_restart --only-enabled early_hal
    task_profiles ServiceCapacityLow
    shutdown critical

# The HIDL service manager (B4c): system_server's HIDL lookups wait for the property it sets,
# hwservicemanager.ready (the engine serves /dev/hwbinder). The Android 13 block, verbatim, without
# "disabled" (B4a left it out; the engine ignores the options it does not model).
service hwservicemanager /system/bin/hwservicemanager
    user system
    group system readproc
    critical
    onrestart setprop hwservicemanager.ready false
    onrestart class_restart --only-enabled main
    onrestart class_restart --only-enabled hal
    onrestart class_restart --only-enabled early_hal
    task_profiles ServiceCapacityLow HighPerformance
    class animation
    shutdown critical

service zygote /system/bin/app_process64 -Xzygote /system/bin --zygote --start-system-server
    class main
    priority -20
    user root
    group root readproc reserved_disk
    socket zygote stream 660 root system
    socket usap_pool_primary stream 660 root system
    onrestart exec_background - system system -- /system/bin/vdc volume abort_fuse
    onrestart write /sys/power/state on
    onrestart restart audioserver
    onrestart restart cameraserver
    onrestart restart media
    onrestart restart media.tuner
    onrestart restart netd
    onrestart restart wificond
    task_profiles ProcessCapacityHigh
    critical window=${zygote.critical_window.minute:-off} target=zygote-fatal

# The system suspend HAL (B4c part 2): the real daemon, with the Android 13 block of its rc, verbatim
# (the capabilities are applied, see engine/init.c). The engine has no /sys/power, so the daemon keeps running (it handles wake
# locks and collects stats) and does not suspend the device: its own main.cpp describes this for hosts
# without platform suspend. system_server's PowerManager waits for it (ISystemSuspend/default).
service system_suspend /system/bin/hw/android.system.suspend@1.0-service
    class early_hal
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND

# installd (B4c part 2): the real daemon, the block of its rc (the "on early-boot" directories of that file
# are for sdcardfs extensions, which the engine does not have; they are not run). system_server's Installer
# waits for it.
service installd /system/bin/installd
    class main

# The power stats HAL (B4c part 2): the mock implementation, the block of its rc from the rootfs. Its
# interface line is what lets init map ctl.interface_* to it; it is started at boot like the others.
service vendor.power.stats-hal-1-0-mock /vendor/bin/hw/android.hardware.power.stats@1.0-service.mock
    interface android.hardware.power.stats@1.0::IPowerStats default
    class hal
    user system
    group system

# The power HAL (B4c part 2): the example implementation (the Android 13 block of AOSP's power-default.rc, with
# class and user as the engine reads them). It serves IPower/default, which system_server's PowerManager waits
# for, and it does not touch /sys. It cannot link yet: android.hardware.power-V3-ndk.so is only in the VNDK APEX
# (/apex/com.android.vndk.current), which the flat linker config (tools/gen-ldconfig.py) does not search. So the
# service is disabled, and its interface line lets servicemanager's lazy start (ctl.interface_start
# aidl/android.hardware.power.IPower/default) start it on demand. docs/boot.md, B4c part 2, has the experiment
# and the decision that is needed.
service vendor.power-default /vendor/bin/hw/android.hardware.power-service.example
    interface aidl android.hardware.power.IPower/default
    disabled
    class hal
    user nobody
    group system

# The light HAL (B4d): the example implementation (AOSP's lights-default.rc block, class and user as the engine
# reads them). It serves ILights/default, which system_server's LightsService waits for (VintfHalCache). Its
# android.hardware.light-V2-ndk.so is in the VNDK APEX, found through the flat search path (tools/gen-ldconfig.py).
# Lazy, like the power HAL: the interface line lets servicemanager start it on demand.
service vendor.light-default /vendor/bin/hw/android.hardware.lights-service.example
    interface aidl android.hardware.light.ILights/default
    disabled
    class hal
    user nobody
    group system

# init derives ro.product.cpu.abilist* from ro.<partition>.product.cpu.abilist* (property_service.cpp,
# property_initialize_ro_cpu_abilist). The engine does not derive them yet: these are the values that
# derivation gives this image (system: abilist64 arm64-v8a, abilist32 empty).
property ro.product.cpu.abilist arm64-v8a
property ro.product.cpu.abilist64 arm64-v8a

# The engine has no OpenGL ES driver (libEGL aborts the preload without one). ZygoteInit skips its GL
# preload when this property is set (ZygoteInit.java, PROPERTY_DISABLE_OPENGL_PRELOADING).
property ro.zygote.disable_gl_preload true

# Graphics (G1, docs/graphics.md section 3.1 A2): SurfaceFlinger, the composer (hwcomposer.ranchu through
# ro.hardware.hwcomposer=ranchu, set in engine/props.c) and the ranchu allocator (goldfish_address_space and
# goldfish_pipe, served by the engine). Each block is the image's own init rc, class and user as the engine reads them:
# surfaceflinger from /system/etc/init/surfaceflinger.rc, the composer from its vendor rc, and the allocator from
# android.hardware.graphics.allocator@3.0-service.rc.
service surfaceflinger /system/bin/surfaceflinger
    class core
    user system
    group graphics drmrpc readproc
    capabilities SYS_NICE

# vendor.hwcomposer-2-4: /vendor/etc/init/android.hardware.graphics.composer@2.4-service.rc
service vendor.hwcomposer-2-4 /vendor/bin/hw/android.hardware.graphics.composer@2.4-service
    class hal
    user system
    group graphics drmrpc

# vendor.gralloc-3-0: /vendor/etc/init/android.hardware.graphics.allocator@3.0-service.rc
service vendor.gralloc-3-0 /vendor/bin/hw/android.hardware.graphics.allocator@3.0-service
    class hal
    user system
    group graphics drmrpc

# The vendor servicemanager (G1): the composer and the other vendor HALs find their services on /dev/vndbinder.
# frameworks/native/cmds/servicemanager/vndservicemanager.rc, class, user and group as the engine reads them
# (task_profiles and onrestart are left out, as for the blocks above).
service vndservicemanager /vendor/bin/vndservicemanager /dev/vndbinder
    class core
    user system
    group system readproc

# lmkd (G1, B9): the low-memory killer, the real binary. ActivityManager connects to its socket. The block of
# system/memory/lmkd/lmkd.rc: class, user, group, capabilities, critical and socket (seqpacket+passcred: lmkd needs
# SCM_CREDENTIALS on every message, and the engine's SO_PASSCRED gives them, sock.c). The memory-pressure inputs are
# PSI files the engine serves (procfs.c, B9). The tail of lmkd.rc (the task_profiles line and the property triggers)
# is not in the block.
service lmkd /system/bin/lmkd
    class core
    user lmkd
    group lmkd system readproc
    capabilities DAC_OVERRIDE KILL IPC_LOCK SYS_NICE SYS_RESOURCE
    critical
    socket lmkd seqpacket+passcred 0660 system system

# idmap2d (G1): the overlay idmap daemon. OverlayManagerService connects to it (IdmapDaemon) and blocks in
# getIdmapService without it. frameworks/base/cmds/idmap2 (system/etc/init/idmap2d.rc), class, user and group as
# the engine reads them.
service idmap2d /system/bin/idmap2d
    class main
    user system
    group system

# The health HAL (B7): the Android 13 block of vendor/etc/init/android.hardware.health@2.1-service.rc, with class,
# user, group and capabilities as the engine reads them. file and task_profiles are not modelled. It reads the
# battery from /sys/class/power_supply (the engine's synthetic tree, engine/powersupply.c). Its uevent socket and
# its CLOCK_BOOTTIME_ALARM wake alarm are optional in healthd's loop: without them it runs (docs/boot.md, B7).
service health-hal-2-1 /vendor/bin/hw/android.hardware.health@2.1-service
    class hal charger
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND

# The sensors HAL (B7): the Android 13 block of vendor/etc/init/android.hardware.sensors@2.1-service-multihal.rc,
# with class, user, group and capabilities as the engine reads them. task_profiles and rlimit are not modelled.
# It talks to the goldfish qemud "sensors" service (engine/sensors.c) on /dev/goldfish_pipe.
service vendor.sensors-hal-2-1-multihal /vendor/bin/hw/android.hardware.sensors@2.1-service.multihal
    class hal
    user system
    group system wakelock context_hub
    capabilities BLOCK_SUSPEND

# The vibrator HAL (B9): the example implementation, the block of hardware/interfaces/vibrator/aidl/default/
# vibrator-default.rc (class, user and group). It registers IVibrator/default and IVibratorManager/default, the two
# names of android.hardware.vibrator.xml (the manifest servicemanager reads). The example has no sysfs input, and
# its stock rc has no interface line: ActivityManager and VibratorManagerService find it at boot, not lazily.
service vendor.vibrator-default /vendor/bin/hw/android.hardware.vibrator-service.example
    class hal
    user nobody
    group nobody

# vold (B10): the real /system/bin/vold, the block of system/vold/vold.rc (class, ioprio and group as the engine reads
# them; task_profiles, shutdown and reboot_on_failure are not modelled). The options are on one line, because the
# engine's rc reader does not join lines with a backslash. Its binder service "vold" is what StorageManagerService
# connects to (docs/boot.md, B10). Its uevent socket is the engine's netlink stub (engine/sockcall.c, sc_socket_netlink).
service vold /system/bin/vold --blkid_context=u:r:blkid:s0 --blkid_untrusted_context=u:r:blkid_untrusted:s0 --fsck_context=u:r:fsck:s0 --fsck_untrusted_context=u:r:fsck_untrusted:s0
    class core
    ioprio be 2
    group root reserved_disk

# netd (B12): xiaoji_netd (device/xiaoji/xiaoji_netd), not the stock netd, which needs bpf(2) and NETLINK_ROUTE. The
# stock capabilities and group, and the same "netd" binder service. The stock sockets (dnsproxyd, fwmarkd, mdns) are
# left out: nothing listens on them yet. NetworkManagementService.create waits for this service.
# KeyMint, the software implementation (AOSP's hardware/interfaces/security/keymint/aidl/default; its package is in
# xiaoji_vendor.mk and its rc is in vendor/etc/init, which this init does not import). keystore2 below needs it (B16).
service vendor.keymint-default /vendor/bin/hw/android.hardware.security.keymint-service
    class early_hal
    user nobody

# keystore2 (the stock keystore2.rc, system/etc/init, B16): LockSettingsService and the legacy KeyStore call it when user 0
# unlocks. Without it the binder answers with a system error and LockSettingsService asserts (KeyStore.state).
service keystore2 /system/bin/keystore2 /data/misc/keystore
    class core
    user keystore
    group keystore readproc log
    task_profiles ProcessCapacityHigh

# gatekeeper (B16): LockSettingsService calls IGateKeeperService.reportDeviceSetupComplete when DEVICE_PROVISIONED changes
# (the Provision app's HOME activity sets it), and that call dies with a NullPointerException in system_server while the
# service is missing. The stock gatekeeperd (class late_start) and its software HAL (class hal) are started here.
service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service.software
    class early_hal
    user system
    group system

service gatekeeperd /system/bin/gatekeeperd /data/misc/gatekeeper
    class core
    user system
    task_profiles ServiceCapacityLow

service netd /system/bin/xiaoji_netd
    class main
    capabilities CHOWN DAC_OVERRIDE DAC_READ_SEARCH FOWNER IPC_LOCK KILL NET_ADMIN NET_BIND_SERVICE NET_RAW SETUID SETGID
    group root net_admin
    onrestart restart zygote

# Audio (B13, docs/boot.md): audioserver, the Android 13 block (frameworks/av/media/audioserver/audioserver.rc),
# with the group mediadrm written as media_drm (the name in engine/ids_gen.h). The restarts of the HALs that are not in
# this product are left out. It registers media.audio_policy, which system_server's AudioService waits for.
service audioserver /system/bin/audioserver
    class core
    user audioserver
    group audio camera drmrpc media media_drm net_bt net_bt_admin net_bw_acct wakelock
    capabilities BLOCK_SUSPEND
    onrestart restart vendor.audio-hal

# The software Codec2 store (B19, docs/boot.md): the block of the swcodec APEX's mediaswcodec.rc (Android 13, SDK 32
# and later), with the user mediacodec and the group mediadrm written as media_codec and media_drm (the names in
# engine/ids_gen.h). It registers android.hardware.media.c2@1.2::IComponentStore/software (the framework manifest's
# entry), which every Codec2 client (MediaCodecList, in the media provider too) waits for. It installs its seccomp
# filter (the APEX's mediaswcodec.policy, through minijail) at start.
service media.swcodec /apex/com.android.media.swcodec/bin/mediaswcodec
    class main
    user media_codec
    group camera drmrpc media_drm
    ioprio rt 4
    task_profiles ProcessCapacityHigh

# The XiaoJi audio HAL (device/xiaoji/audio): the null sink, as the HIDL passthrough service. The block of the stock
# hardware/interfaces/audio service (vendor.audio-hal), with /vendor/bin/hw/xiaoji_audio_hal in place of the stock
# binary, whose main aborts in this tree (docs/boot.md, B12).
service vendor.audio-hal /vendor/bin/hw/xiaoji_audio_hal
    interface android.hardware.audio@7.0::IDevicesFactory default
    interface android.hardware.audio.effect@7.0::IEffectsFactory default
    class hal
    user audioserver
    group audio camera drmrpc inet media media_drm net_bt net_bt_admin net_bw_acct wakelock context_hub
    capabilities BLOCK_SUSPEND
    onrestart restart audioserver

# Thermal HAL (B14): the stock block of /vendor/etc/init/android.hardware.thermal@2.0-service.rc, the 2.0 mock. It serves
# both IThermal 2.0 (ThermalManagerService) and IThermal 1.0 (HardwarePropertiesManagerService, which takes 1.0 on the
# system_server's main thread, with no timeout). It replaces the 1.0 service of B13: both would register @1.0::IThermal/default.
service vendor.thermal-hal-2-0-mock /vendor/bin/hw/android.hardware.thermal@2.0-service.mock
    interface android.hardware.thermal@1.0::IThermal default
    interface android.hardware.thermal@2.0::IThermal default
    class hal
    user system
    group system

# Authsecret HAL 1.0 (B13): the default service of hardware/interfaces/authsecret/1.0/default (installed by the product,
# from the goldfish vendor packages), with the block of its rc. LockSettingsService takes IAuthSecret at boot, on the
# system_server's main thread, with no timeout.
service vendor.authsecret-1-0 /vendor/bin/hw/android.hardware.authsecret@1.0-service
    interface android.hardware.authsecret@1.0::IAuthSecret default
    class hal
    user system
    group system
